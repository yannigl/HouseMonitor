{
  "ha_url": "http://127.0.0.1:8123",
  "ha_token": "LONG_LIVED_ACCESS_TOKEN",
  "telegram_token": "123456:ABC...",
  "telegram_chat_id": "123456789",

  "healthchecks": {
    "url": "https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
    "ping_interval_hours": 4,
    "period_hours": 4,
    "grace_hours": 1
  },

  "shutdown": {
    "healthchecks": "fail",
    "dry_run": false
  },

  "listener": {
    "poll_timeout": 300,
    "slow_poll_hours": 24
  },

  "summary": {
    "voltage_range": [200, 250]
  },
  "control": {
    "domains": ["switch"],
    "exclude": []
  },
  "arm": {
    "groups": {}
  },
  "hours": 24,
  "hide_unavailable": true,
  "domains": ["sensor", "binary_sensor", "switch", "light", "input_boolean"],
  "exclude": ["sensor.sun_", "binary_sensor.updater", "sensor.time"]
}
