[Unit]
Description=HouseMonitor SMS web page (local network)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/HouseMonitor
ExecStart=/usr/bin/python3 /home/pi/HouseMonitor/smsweb.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
